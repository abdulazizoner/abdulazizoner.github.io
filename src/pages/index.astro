---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SkillCard from '@/components/SkillCard.astro';
import I18n from '@/components/I18n.astro';
import { assetPath } from '@/utils/base';
import { SITE, hero, about, skills, education } from '@/data/site';
---

<BaseLayout
  title="Abdülaziz Öner — AI & Data Engineering Student"
  description="Abdülaziz Öner, AI & Data Engineering student at Fırat University. Python, SQL, data analysis and natural language processing."
  path=""
  pageId="home"
  siteName={true}
>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-heading">

      <div class="container hero-grid">
        <div class="hero-content">
          <h1 id="hero-heading">
            Abdülaziz Öner
          </h1>
          <p class="hero-title">
            <I18n en={hero.title.en} tr={hero.title.tr} stable />
          </p>
          <p class="hero-lead">
            <I18n en={hero.lead.en} tr={hero.lead.tr} stable />
          </p>
          <div class="hero-cta">
            <a class="btn" href={SITE.github} target="_blank" rel="noopener noreferrer">
              <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                ></path></svg
              >
              GitHub
            </a>
            <a class="btn" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
              <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path></svg
              >
              LinkedIn
            </a>
            <a class="btn" href={SITE.email} target="_blank" rel="noopener noreferrer">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path></svg
              >
              <I18n en="Email" tr="E-posta" />
            </a>
            <a class="btn" href={SITE.huggingface} target="_blank" rel="noopener noreferrer">
              <img class="button-logo" src={assetPath('assets/huggingface.svg')} width="18" height="18" alt="" aria-hidden="true" />
              Hugging Face
            </a>
            <a class="btn" href={assetPath('assets/cv.pdf')} download="Abdulaziz-Oner-CV.pdf">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m-4-4 4 4 4-4M5 16v5h14v-5" /></svg>
              <I18n en="Download CV" tr="CV’yi indir" />
            </a>
          </div>
        </div>
        <figure class="hero-portrait">
          <img src={assetPath('assets/profile.jpg')} alt="Abdülaziz Öner" width="1254" height="1254" fetchpriority="high" />
          <figcaption><I18n en="AI & Data Engineering student" tr="Yapay Zeka ve Veri Mühendisliği öğrencisi" /></figcaption>
        </figure>
      </div>
    </section>

    <section id="about" class="section reveal" aria-labelledby="about-heading">
      <div class="container">
        <SectionHeader


          titleEn="About"
          titleTr="Hakkında"


          headingId="about-heading"
        />
        {
          about.paragraphs.map((p) => (
            <p class="section-intro">
              <I18n en={p.en} tr={p.tr} html />
            </p>
          ))
        }
        <div class="tag-row">
          {
            about.tags.map((tag) => {
              if ('text' in tag) {
                return <span class="tag">{tag.text}</span>;
              }
              const variant = tag.variant ? `tag-${tag.variant}` : '';
              return <I18n en={tag.en} tr={tag.tr} class={`tag ${variant}`.trim()} />;
            })
          }
        </div>
      </div>
    </section>

    <section id="skills" class="section reveal" aria-labelledby="skills-heading">
      <div class="container">
        <SectionHeader


          titleEn="Technical Skills & Interests"
          titleTr="Teknik Yetkinlikler ve İlgi Alanları"


          headingId="skills-heading"
        />
        <p class="section-intro"><I18n en="The tools I work with and the areas I am developing through coursework and independent practice. My interests connect data preparation, analysis, language models and software delivery." tr="Dersler ve bireysel çalışmalarla deneyim kazandığım araçlar ve kendimi geliştirdiğim alanlar. Veri hazırlama, analiz, dil modelleri ve yazılım geliştirmeyi bir bütün olarak ele alıyorum." /></p>
        <div class="skills-grid">
          {skills.map((card) => <SkillCard card={card} />)}
        </div>
      </div>
    </section>

    <section id="education" class="section reveal" aria-labelledby="education-heading">
      <div class="container">
        <SectionHeader


          titleEn="Education & Certificates"
          titleTr="Eğitim ve Sertifikalar"


          headingId="education-heading"
        />
        <div class="edu-list">
          {
            education.map((item) => (
              <article class="edu-item">
                <h3>
                  <I18n en={item.title.en} tr={item.title.tr} />
                </h3>
                <p class="org"><I18n en={item.org} tr={item.org === "Fırat University" ? "Fırat Üniversitesi" : item.org} /></p>
                <p class="period">
                  <I18n en={item.period.en} tr={item.period.tr} />
                </p>
                <p>
                  <I18n en={item.description.en} tr={item.description.tr} />
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
